---
import { getCollection } from "astro:content";
import Layout from "../layouts/Layout.astro";
import CategorySection from "../components/molecules/CategorySection.astro";
import { CATEGORY_SLUGS, CATEGORY_META } from "../data/categories";
import type { Props as CourseCardProps } from "../components/molecules/CourseCard.astro";

const courses = await getCollection("courses");
const allTopics = await getCollection("topics");

const courseCards: CourseCardProps[] = courses.map((course) => {
  const courseTopics = allTopics
    .filter((topic) => topic.data.course.id === course.id)
    .sort((a, b) => {
      const phaseDiff =
        course.data.phases.findIndex((phase) => phase.id === a.data.phase) -
        course.data.phases.findIndex((phase) => phase.id === b.data.phase);
      return phaseDiff !== 0 ? phaseDiff : a.data.order - b.data.order;
    });

  const topics = courseTopics.map((topic) => {
    const phase = course.data.phases.find((p) => p.id === topic.data.phase);
    const topicSlug = topic.id.split("/").at(-1);
    return { id: topic.id, href: `/${course.id}/${phase?.slug}/${topicSlug}` };
  });

  return {
    href: topics[0]?.href ?? "#",
    name: course.data.name,
    description: course.data.description,
    category: course.data.category,
    phaseCount: course.data.phases.length,
    topicCount: courseTopics.length,
    topics,
  };
});

const categorySections = CATEGORY_SLUGS.map((slug) => ({
  slug,
  meta: CATEGORY_META[slug],
  courses: courseCards.filter((card) => card.category === slug),
})).filter((section) => section.courses.length > 0);
---

<Layout>
  <div class="flex flex-col gap-10 w-full py-8">
    <header class="flex flex-col md:flex-row md:items-start md:justify-between gap-4">
      <div class="flex flex-col gap-2">
        <p class="text-sm font-semibold text-emerald-400 uppercase tracking-wide">Plataforma de cursos</p>
        <h1 class="text-3xl font-bold text-slate-50">GreenNodo</h1>
        <p class="text-slate-400 text-sm">
          Elige una categoría y empieza a aprender a tu ritmo. Tu progreso se guarda automáticamente en este navegador.
        </p>
      </div>

      <div data-home-greeting class="flex flex-col items-start md:items-end gap-1 shrink-0">
        <p class="home-greeting-text text-sm text-slate-300">Bienvenido 👋</p>
        <button
          type="button"
          data-open-profile-modal
          class="home-greeting-action text-xs font-semibold text-emerald-400 hover:text-emerald-300 transition-colors"
        >
          Completa tu perfil
        </button>
      </div>
    </header>

    {
      categorySections.map((section) => (
        <CategorySection icon={section.meta.icon} label={section.meta.label} courses={section.courses} />
      ))
    }
  </div>
</Layout>

<script>
  import { getCompletedTopicIds, onProgressUpdated } from "../scripts/progress";
  import { getStudent, onStudentUpdated } from "../scripts/student";

  function refreshCourseCards() {
    const completed = new Set(getCompletedTopicIds());

    document.querySelectorAll<HTMLElement>("[data-course-card]").forEach((card) => {
      const topicsJson = card.querySelector<HTMLScriptElement>("[data-course-topics]")?.textContent ?? "[]";
      const topics: { id: string; href: string }[] = JSON.parse(topicsJson);
      const total = topics.length;
      const doneCount = topics.filter((topic) => completed.has(topic.id)).length;
      const percent = total > 0 ? Math.round((doneCount / total) * 100) : 0;

      const fill = card.querySelector<HTMLElement>(".progress-fill");
      const text = card.querySelector<HTMLElement>(".progress-text");
      if (fill) fill.style.width = `${percent}%`;
      if (text) text.textContent = `${percent}%`;

      const cta = card.querySelector<HTMLAnchorElement>("[data-course-cta]");
      if (cta) {
        if (percent >= 100) {
          cta.textContent = "Repasar curso";
          cta.href = topics[0]?.href ?? cta.href;
        } else if (percent > 0) {
          const nextTopic = topics.find((topic) => !completed.has(topic.id));
          cta.textContent = "Continuar curso";
          cta.href = nextTopic?.href ?? cta.href;
        } else {
          cta.textContent = "Empezar curso";
          cta.href = topics[0]?.href ?? cta.href;
        }
      }
    });
  }

  function refreshGreeting() {
    const greeting = document.querySelector("[data-home-greeting]");
    if (!greeting) return;

    const student = getStudent();
    const text = greeting.querySelector<HTMLElement>(".home-greeting-text");
    const action = greeting.querySelector<HTMLElement>(".home-greeting-action");

    if (student) {
      if (text) text.textContent = `Hola, ${student.firstName} 👋`;
      if (action) action.textContent = "Editar perfil";
    } else {
      if (text) text.textContent = "Bienvenido 👋";
      if (action) action.textContent = "Completa tu perfil";
    }
  }

  onProgressUpdated(refreshCourseCards);
  refreshCourseCards();

  onStudentUpdated(refreshGreeting);
  refreshGreeting();
</script>
