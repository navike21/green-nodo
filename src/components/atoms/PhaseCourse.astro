---
export interface Props {
  phase: string;
  title: string;
}

const { phase, title } = Astro.props;

---
<div class="title bg-slate-900 px-5 py-3 flex flex-row gap-2 items-center">
  <h4 class="uppercase">
    <span class="text-xs font-semibold text-emerald-100/70">{phase}: </span>
    <span class="text-xs font-semibold text-emerald-500">{title}</span>
  </h4>
</div>
