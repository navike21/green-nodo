---
export type ChipVariants = "information" | "success" | "warning" | "error" | "purple" | "default";

export interface Props {
  text: string;
  variant?: ChipVariants;
}

const { text, variant = "default" } = Astro.props;

const variantClasses: Record<ChipVariants, string> = {
  information: "bg-blue-500/40 border-blue-500/40 text-blue-200 ",
  success: "bg-green-500/40 border-green-500/40 text-green-200",
  warning: "bg-yellow-500/40 border-yellow-500/40 text-yellow-200",
  error: "bg-red-500/40 border-red-500/40 text-red-200",
  purple: "bg-purple-500/40 border-purple-500/40 text-purple-200",
  default: "bg-slate-500/40 border-slate-500/40 text-slate-200",
};
---

<span class={`${variantClasses[variant]} border flex justify-center px-2 py-1 rounded-lg text-[10px] font-bold max-w-28 w-fit min-w-12 text-center`}>
  {text}
</span>
