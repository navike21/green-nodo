---
import CourseCard, { type Props as CourseCardProps } from "./CourseCard.astro";

export interface Props {
  icon: string;
  label: string;
  courses: CourseCardProps[];
}

const { icon, label, courses } = Astro.props;
---

<section class="flex flex-col gap-4 w-full">
  <div class="flex items-center gap-2">
    <span class="text-2xl">{icon}</span>
    <h2 class="text-xl font-bold text-slate-50">{label}</h2>
    <span class="text-xs text-slate-500">({courses.length} curso{courses.length === 1 ? "" : "s"})</span>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-6">
    {courses.map((course) => <CourseCard {...course} />)}
  </div>
</section>
