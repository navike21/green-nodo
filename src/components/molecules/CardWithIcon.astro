---
export interface Props {
  color: 'green'| 'yellow'| 'red'| 'blue'| 'purple';
  content: string;
  icon: string;
  title: string;
}

const { color, icon, title, content } = Astro.props

const variantColors: Record<Props["color"], string> = {
  blue: "bg-blue-500/10 border-blue-500/40",
  red: "bg-red-500/10 border-red-500/40",
  green: "bg-green-500/10 border-green-500/40",
  yellow: "bg-yellow-500/10 border-yellow-500/40",
  purple: "bg-purple-500/10 border-purple-500/40"
}

const variantColorsTitle: Record<Props["color"], string> = {
  blue: "text-blue-500",
  red: "text-red-500",
  green: "text-green-500",
  yellow: "text-yellow-500",
  purple: "text-purple-500"
}
---

<div class={`${variantColors[color]} border flex px-5 py-6 gap-4 rounded-xl`}>
  <div>{icon}</div>
  <div class="flex gap-2 flex-col">
    <h4 class={`${variantColorsTitle[color]} font-semibold`}>{title}</h4>
    <div class="text-slate-100 text-sm">
      {content}
    </div>
  </div>
</div>

