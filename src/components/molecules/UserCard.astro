---
---
<div class="bg-emerald-800/20 flex gap-3 items-center px-3 py-2.5 border-emerald-500/40 border rounded-xl w-full" data-user-card>
  <div class="user-card-avatar w-9 h-9 rounded-full bg-emerald-900 flex items-center justify-center font-bold text-emerald-500 border-emerald-500 border text-xs shrink-0">
    ?
  </div>
  <div class="flex flex-col gap-0.5 flex-1 min-w-0">
    <h5 class="user-card-role text-xs font-medium uppercase text-slate-400">
      Invitado
    </h5>
    <h4 class="user-card-name text-sm font-semibold truncate">
      Completa tu perfil
    </h4>
  </div>
  <button
    type="button"
    data-open-profile-modal
    class="user-card-action text-xs font-semibold text-emerald-400 hover:text-emerald-300 transition-colors shrink-0"
  >
    Completar
  </button>
</div>

<script>
  import { getStudent, getInitials, onStudentUpdated } from "../../scripts/student";

  function refresh() {
    const card = document.querySelector("[data-user-card]");
    if (!card) return;

    const student = getStudent();
    const avatar = card.querySelector(".user-card-avatar");
    const role = card.querySelector(".user-card-role");
    const name = card.querySelector(".user-card-name");
    const action = card.querySelector(".user-card-action");

    if (student) {
      if (avatar) avatar.textContent = getInitials(student);
      if (role) role.textContent = "Estudiante";
      if (name) name.textContent = `${student.firstName} ${student.lastName}`;
      if (action) action.textContent = "Editar";
    } else {
      if (avatar) avatar.textContent = "?";
      if (role) role.textContent = "Invitado";
      if (name) name.textContent = "Completa tu perfil";
      if (action) action.textContent = "Completar";
    }
  }

  onStudentUpdated(refresh);
  refresh();
</script>
