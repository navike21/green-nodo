---
import Chip from "../atoms/Chip.astro";
import ProgressBar from "../atoms/ProgressBar.astro";
import { CATEGORY_META, type CourseCategory } from "../../data/categories";

export interface CourseCardTopic {
  id: string;
  href: string;
}

export interface Props {
  href: string;
  name: string;
  description: string;
  category: CourseCategory;
  phaseCount: number;
  topicCount: number;
  topics: CourseCardTopic[];
}

const { href, name, description, category, phaseCount, topicCount, topics } = Astro.props;
const meta = CATEGORY_META[category];
const topicsJson = JSON.stringify(topics).replace(/</g, "\\u003c");
---

<article class="flex flex-col gap-4 w-full rounded-xl border border-slate-700/60 bg-slate-900/40 p-6" data-course-card>
  <script type="application/json" data-course-topics set:html={topicsJson} is:inline />

  <Chip text={`${meta.icon} ${meta.label}`} variant={meta.chipVariant} />

  <div class="flex flex-col gap-1">
    <h3 class="text-xl font-bold text-slate-50">{name}</h3>
    <p class="text-sm text-slate-300 line-clamp-2">{description}</p>
  </div>

  <p class="text-xs text-slate-500">{phaseCount} fases · {topicCount} temas</p>

  <ProgressBar totalTopics={topics.length} />

  <a
    data-course-cta
    href={href}
    class="inline-block rounded bg-emerald-500 text-white hover:bg-emerald-600 px-4 py-2.5 text-xs font-semibold text-center transition-all w-full"
  >
    Empezar curso
  </a>
</article>
